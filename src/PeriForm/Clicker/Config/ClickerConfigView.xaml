<UserControl x:Class="PeriForm.Clicker.Config.ClickerConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PeriForm.Clicker.Config"
             xmlns:click="clr-namespace:PeriForm.Domain.Clicker;assembly=PeriForm.Domain"
             xmlns:enums="clr-namespace:PeriForm.Domain.Infrastructure.Enum;assembly=PeriForm.Domain"
             xmlns:controls="clr-namespace:PeriForm.Infrastructure.Controls"
             xmlns:converters="clr-namespace:PeriForm.Infrastructure.Converters"
             xmlns:viewModel="clr-namespace:PeriForm.Infrastructure.ViewModel"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ClickerConfigDesignModel, IsDesignTimeCreatable=True}"
             viewModel:ViewModelLocator.WireViewModel="{x:Type local:ClickerConfigViewModel}">

    <UserControl.Resources>
        <!-- enum sources -->
        <ObjectDataProvider x:Key="RunModesProvider" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:ConfigRunMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="MouseButtonsProvider" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="click:MouseButton" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- layout -->
        <Style x:Key="FormRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />
        </Style>

        <!-- MahApps numeric for ExecutionCount -->
        <Style x:Key="MsNumeric" TargetType="{x:Type mah:NumericUpDown}"
               BasedOn="{StaticResource {x:Type mah:NumericUpDown}}">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1000000000" />
            <Setter Property="Interval" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Validation border for masked fields -->
        <Style TargetType="{x:Type controls:MaskedTextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <DockPanel LastChildFill="True">
                            <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                                    BorderThickness="1" CornerRadius="3">
                                <AdornedElementPlaceholder />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Border CornerRadius="8" Padding="10"
                Background="{DynamicResource MahApps.Brushes.Control.Background}">
            <Expander x:Name="RootExpander" IsExpanded="True">
                <!-- HEADER with (unnamed) fallback -->
                <Expander.Header>
                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text">
                                    <Setter.Value>
                                        <MultiBinding StringFormat="{}{0} — {1} — {2} — {3:c}">
                                            <Binding Path="Name" />
                                            <Binding Path="MouseButton" />
                                            <Binding Path="RunMode" />
                                            <Binding Path="ClickInterval" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Name}" Value="">
                                        <Setter Property="Text">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}(unnamed) — {0} — {1} — {2:c}">
                                                    <Binding Path="MouseButton" />
                                                    <Binding Path="RunMode" />
                                                    <Binding Path="ClickInterval" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Opacity" Value="0.8" />
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Expander.Header>

                <!-- BODY -->
                <Border Padding="14" Margin="0,14,0,0"
                        CornerRadius="6"
                        Background="{DynamicResource MahApps.Brushes.Control.Background}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource MahApps.Brushes.ThemeBorder}">
                    <StackPanel Grid.IsSharedSizeScope="True">

                        <!-- Name -->
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" SharedSizeGroup="label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Content="Name" Style="{StaticResource FormLabel}" Target="{Binding ElementName=NameBox}" />
                            <TextBox x:Name="NameBox"
                                     Grid.Column="1" MinWidth="220"
                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"
                                       Text="Label shown in the list and summary." />
                        </Grid>

                        <!-- Mouse Button -->
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" SharedSizeGroup="label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Content="Mouse Button" Style="{StaticResource FormLabel}" Target="{Binding ElementName=MouseBox}" />
                            <ComboBox x:Name="MouseBox"
                                      Grid.Column="1" MinWidth="180"
                                      ItemsSource="{Binding Source={StaticResource MouseButtonsProvider}}"
                                      SelectedItem="{Binding MouseButton, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={converters:EnumDisplayNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"
                                       Text="Which button is pressed (Left/Right/Middle/X...)." />
                        </Grid>

                        <!-- Click Interval -->
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" SharedSizeGroup="label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Content="Click Interval" Style="{StaticResource FormLabel}" Target="{Binding ElementName=IntervalBox}" />
                            <controls:TimeSpanPicker x:Name="IntervalBox"
                                                     Grid.Column="1"
                                                     MinWidth="180"
                                                     SelectedTimeSpan="{Binding Path=ClickInterval, Mode=TwoWay}"
                                                     MaxHours="23" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"
                                       Text="Delay between clicks (hh:mm:ss.fff)." />
                        </Grid>

                        <!-- Hold Duration -->
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" SharedSizeGroup="label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Content="Hold Duration" Style="{StaticResource FormLabel}" Target="{Binding ElementName=HoldBox}" />
                            <controls:TimeSpanPicker x:Name="HoldBox"
                                                     Grid.Column="1"
                                                     MinWidth="180"
                                                     SelectedTimeSpan="{Binding Path=HoldDuration, Mode=TwoWay}"
                                                     MaxHours="23" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"
                                       Text="Time the button is held down (hh:mm:ss.fff)." />
                        </Grid>

                        <!-- Pause Duration (UPDATED) -->
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" SharedSizeGroup="label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Content="Pause Duration" Style="{StaticResource FormLabel}" Target="{Binding ElementName=PauseBox}" />
                            <controls:TimeSpanPicker x:Name="PauseBox"
                                                     Grid.Column="1"
                                                     MinWidth="180"
                                                     SelectedTimeSpan="{Binding Path=PauseDuration, Mode=TwoWay}"
                                                     MaxHours="23" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"
                                       Text="Extra wait after each cycle (hh:mm:ss.fff)." />
                        </Grid>

                        <!-- Run Mode -->
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" SharedSizeGroup="label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Content="Run Mode" Style="{StaticResource FormLabel}" Target="{Binding ElementName=RunModeBox}" />
                            <ComboBox x:Name="RunModeBox"
                                      Grid.Column="1" MinWidth="180"
                                      ItemsSource="{Binding Source={StaticResource RunModesProvider}}"
                                      SelectedItem="{Binding RunMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={converters:EnumDisplayNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"
                                       Text="Indefinite • N runs • Fixed time." />
                        </Grid>

                        <!-- Execution Count -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid" BasedOn="{StaticResource FormRow}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RunMode}" Value="{x:Static enums:ConfigRunMode.ExecutionCount}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" SharedSizeGroup="label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Content="Execution Count" Style="{StaticResource FormLabel}" Target="{Binding ElementName=CountBox}" />
                            <mah:NumericUpDown x:Name="CountBox"
                                               Grid.Column="1"
                                               Minimum="1" Maximum="1000000" Interval="1"
                                               Value="{Binding ExecutionCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"
                                       Text="How many clicks to perform before stopping." />
                        </Grid>

                        <!-- Duration -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid" BasedOn="{StaticResource FormRow}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RunMode}" Value="{x:Static enums:ConfigRunMode.Duration}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" SharedSizeGroup="label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Content="Duration" Style="{StaticResource FormLabel}" Target="{Binding ElementName=DurationBox}" />
                            <controls:TimeSpanPicker x:Name="DurationBox"
                                                     Grid.Column="1"
                                                     MinWidth="180"
                                                     SelectedTimeSpan="{Binding Path=Duration, Mode=TwoWay}"
                                                     MaxHours="23" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"
                                       Text="Total time to run before stopping (hh:mm:ss.fff)." />
                        </Grid>

                        <TextBlock Margin="0,6,0,6" />

                        <!-- Hotkeys -->
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" SharedSizeGroup="label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Content="Start Hotkey" Style="{StaticResource FormLabel}" Target="{Binding ElementName=StartKeyBox}" />
                            <mah:HotKeyBox x:Name="StartKeyBox"
                                           Grid.Column="1"
                                           HotKey="{Binding StartHotKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           mah:TextBoxHelper.Watermark="Click then press keys" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"
                                       Text="May share the same key with Stop; together they toggle." />
                        </Grid>

                        <Grid Style="{StaticResource FormRow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" SharedSizeGroup="label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Content="Stop Hotkey" Style="{StaticResource FormLabel}" Target="{Binding ElementName=StopKeyBox}" />
                            <mah:HotKeyBox x:Name="StopKeyBox"
                                           Grid.Column="1"
                                           HotKey="{Binding StopHotKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           mah:TextBoxHelper.Watermark="Click then press keys" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}"
                                       Text="Same key allowed; when equal to Start it toggles start/stop." />
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>
        </Border>
    </Grid>
</UserControl>